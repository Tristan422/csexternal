#pragma once
#include <windows.h>
#include <tlhelp32.h>
#include <cstdio>
#include <cstring>

class SkinInjector {
public:
    static DWORD GetPid(const char* name) {
        HANDLE s = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
        if (s == INVALID_HANDLE_VALUE) return 0;
        PROCESSENTRY32 p{}; p.dwSize = sizeof(p);
        DWORD pid = 0;
        if (Process32First(s, &p)) {
            do { if (_stricmp(p.szExeFile, name) == 0) { pid = p.th32ProcessID; break; } }
            while (Process32Next(s, &p));
        }
        CloseHandle(s);
        return pid;
    }
    static bool Inject(const char* dllPath, const char* procName = "cs2.exe") {
        DWORD pid = GetPid(procName);
        if (!pid) { printf("[Injector] %s not running\n", procName); return false; }
        HANDLE h = OpenProcess(PROCESS_ALL_ACCESS, FALSE, pid);
        if (!h) { printf("[Injector] OpenProcess failed (%lu)\n", GetLastError()); return false; }
        size_t len = strlen(dllPath) + 1;
        LPVOID rs = VirtualAllocEx(h, nullptr, len, MEM_COMMIT|MEM_RESERVE, PAGE_READWRITE);
        if (!rs) { CloseHandle(h); return false; }
        WriteProcessMemory(h, rs, dllPath, len, nullptr);
        HMODULE k32 = GetModuleHandleA("kernel32.dll");
        LPTHREAD_START_ROUTINE load = (LPTHREAD_START_ROUTINE)GetProcAddress(k32, "LoadLibraryA");
        HANDLE th = CreateRemoteThread(h, nullptr, 0, load, rs, 0, nullptr);
        if (!th) { VirtualFreeEx(h, rs, 0, MEM_RELEASE); CloseHandle(h); return false; }
        WaitForSingleObject(th, 5000);
        DWORD ec = 0; GetExitCodeThread(th, &ec);
        CloseHandle(th);
        VirtualFreeEx(h, rs, 0, MEM_RELEASE);
        CloseHandle(h);
        printf("[Injector] DLL at 0x%llX\n", (unsigned long long)ec);
        return ec != 0;
    }
};