#include <dwmapi.h>
#include <windows.h>
#pragma comment(lib, "d3d11.lib")
#pragma comment(lib, "dxgi.lib")
#pragma comment(lib, "dwmapi.lib")

extern IMGUI_IMPL_API LRESULT ImGui_ImplWin32_WndProcHandler(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam);

namespace Render {
    inline ID3D11Device*           g_device        = nullptr;
    inline ID3D11DeviceContext*    g_context       = nullptr;
    inline IDXGISwapChain*         g_swapChain     = nullptr;
    inline ID3D11RenderTargetView* g_rtv           = nullptr;
    inline HWND                    g_hwnd          = nullptr;
    inline bool                    g_initialized   = false;

    inline LRESULT CALLBACK WndProc(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam) {
        if (ImGui_ImplWin32_WndProcHandler(hWnd, msg, wParam, lParam)) return true;
        if (msg == WM_DESTROY) { PostQuitMessage(0); return 0; }
        if (msg == WM_ERASEBKGND) return 1;
        if (msg == WM_MOUSEMOVE) { gInput.mouse.x = GET_X_LPARAM(lParam); gInput.mouse.y = GET_Y_LPARAM(lParam); return 0; }
        if (msg == WM_LBUTTONDOWN) { gInput.lmbDown = true; gInput.lmbJustPressed = true; SetCapture(hWnd); return 0; }
        if (msg == WM_LBUTTONUP) { gInput.lmbDown = false; ReleaseCapture(); return 0; }
        return DefWindowProc(hWnd, msg, wParam, lParam);
    }

    inline bool CreateDeviceD3D(HWND hWnd) {
        DXGI_SWAP_CHAIN_DESC sd{};
        sd.BufferCount = 2;
        sd.BufferDesc.Width = 0;
        sd.BufferDesc.Height = 0;
        sd.BufferDesc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
        sd.BufferDesc.RefreshRate.Numerator = 0;
        sd.BufferDesc.RefreshRate.Denominator = 1;
        sd.Flags = DXGI_SWAP_CHAIN_FLAG_ALLOW_MODE_SWITCH;
        sd.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
        sd.OutputWindow = hWnd;
        sd.SampleDesc.Count = 1;
        sd.SampleDesc.Quality = 0;
        sd.Windowed = TRUE;
        sd.SwapEffect = DXGI_SWAP_EFFECT_DISCARD;

        D3D_FEATURE_LEVEL featureLevel;
        const D3D_FEATURE_LEVEL featureLevelArray[2] = { D3D_FEATURE_LEVEL_11_0, D3D_FEATURE_LEVEL_10_0 };
        HRESULT res = D3D11CreateDeviceAndSwapChain(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, 0,
            featureLevelArray, 2, D3D11_SDK_VERSION, &sd, &g_swapChain, &g_device, &featureLevel, &g_context);
        if (res == DXGI_ERROR_UNSUPPORTED)
            res = D3D11CreateDeviceAndSwapChain(nullptr, D3D_DRIVER_TYPE_WARP, nullptr, 0,
                featureLevelArray, 2, D3D11_SDK_VERSION, &sd, &g_swapChain, &g_device, &featureLevel, &g_context);
        if (FAILED(res)) return false;

        ID3D11Texture2D* backBuffer = nullptr;
        g_swapChain->GetBuffer(0, IID_PPV_ARGS(&backBuffer));
        if (backBuffer) { g_device->CreateRenderTargetView(backBuffer, nullptr, &g_rtv); backBuffer->Release(); }
        return true;
    }

    inline bool Init(HWND hwnd) {
        g_hwnd = hwnd;
        if (!CreateDeviceD3D(hwnd)) return false;

        ShowWindow(hwnd, SW_SHOW);
        UpdateWindow(hwnd);

        IMGUI_CHECKVERSION();
        ImGui::CreateContext();
        ImGuiIO& io = ImGui::GetIO();
        io.ConfigFlags |= ImGuiConfigFlags_NavEnableKeyboard;
        io.IniFilename = nullptr;
        io.LogFilename = nullptr;

        ImGui::StyleColorsDark();
        ImGuiStyle& style = ImGui::GetStyle();
        style.WindowRounding = 8.0f;
        style.FrameRounding = 4.0f;
        style.GrabRounding = 4.0f;
        style.WindowBorderSize = 1.0f;
        style.FrameBorderSize = 0.0f;
        style.WindowPadding = ImVec2(12, 12);
        style.FramePadding = ImVec2(8, 6);
        style.ItemSpacing = ImVec2(8, 8);

        ImVec4* colors = style.Colors;
        colors[ImGuiCol_WindowBg]         = ImVec4(0.05f, 0.05f, 0.07f, 0.98f);
        colors[ImGuiCol_Border]           = ImVec4(0.13f, 0.11f, 0.17f, 1.00f);
        colors[ImGuiCol_FrameBg]          = ImVec4(0.08f, 0.08f, 0.11f, 1.00f);
        colors[ImGuiCol_FrameBgHovered]   = ImVec4(0.11f, 0.11f, 0.15f, 1.00f);
        colors[ImGuiCol_FrameBgActive]    = ImVec4(0.13f, 0.13f, 0.18f, 1.00f);
        colors[ImGuiCol_CheckMark]        = ImVec4(0.66f, 0.33f, 0.97f, 1.00f);
        colors[ImGuiCol_SliderGrab]       = ImVec4(0.66f, 0.33f, 0.97f, 1.00f);
        colors[ImGuiCol_SliderGrabActive] = ImVec4(0.85f, 0.27f, 0.94f, 1.00f);
        colors[ImGuiCol_Button]           = ImVec4(0.11f, 0.09f, 0.15f, 1.00f);
        colors[ImGuiCol_ButtonHovered]    = ImVec4(0.66f, 0.33f, 0.97f, 0.60f);
        colors[ImGuiCol_ButtonActive]     = ImVec4(0.66f, 0.33f, 0.97f, 0.90f);
        colors[ImGuiCol_Header]           = ImVec4(0.13f, 0.11f, 0.17f, 1.00f);
        colors[ImGuiCol_HeaderHovered]    = ImVec4(0.20f, 0.16f, 0.28f, 1.00f);
        colors[ImGuiCol_HeaderActive]     = ImVec4(0.66f, 0.33f, 0.97f, 0.60f);
        colors[ImGuiCol_Tab]              = ImVec4(0.08f, 0.08f, 0.11f, 1.00f);
        colors[ImGuiCol_TabHovered]       = ImVec4(0.66f, 0.33f, 0.97f, 0.60f);
        colors[ImGuiCol_TabActive]        = ImVec4(0.66f, 0.33f, 0.97f, 0.80f);
        colors[ImGuiCol_TitleBg]          = ImVec4(0.05f, 0.05f, 0.07f, 1.00f);
        colors[ImGuiCol_TitleBgActive]    = ImVec4(0.08f, 0.08f, 0.11f, 1.00f);

        ImGui_ImplWin32_Init(hwnd);
        ImGui_ImplDX11_Init(g_device, g_context);

        g_initialized = true;
        return true;
    }

    inline void BeginFrame() {
        if (!g_initialized) return;
        ImGui_ImplDX11_NewFrame();
        ImGui_ImplWin32_NewFrame();
        ImGui::NewFrame();
    }

    inline void EndFrame() {
        if (!g_initialized) return;
        ImGui::Render();
        const float clear[4] = { 0, 0, 0, 0 };
        g_context->OMSetRenderTargets(1, &g_rtv, nullptr);
        g_context->ClearRenderTargetView(g_rtv, clear);
        ImGui_ImplDX11_RenderDrawData(ImGui::GetDrawData());
        g_swapChain->Present(0, 0);
    }

    inline void Shutdown() {
        if (!g_initialized) return;
        ImGui_ImplDX11_Shutdown();
        ImGui_ImplWin32_Shutdown();
        ImGui::DestroyContext();
        if (g_rtv) g_rtv->Release();
        if (g_swapChain) g_swapChain->Release();
        if (g_context) g_context->Release();
        if (g_device) g_device->Release();
        g_initialized = false;
    }

    inline bool CreateOverlayWindow() {
        WNDCLASSEXA wc{};
        wc.cbSize = sizeof(wc);
        wc.style = CS_CLASSDC;
        wc.lpfnWndProc = WndProc;
        wc.hInstance = GetModuleHandle(nullptr);
        wc.lpszClassName = "NullWareD3D11";
        wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
        RegisterClassExA(&wc);

        int sw = GetSystemMetrics(SM_CXSCREEN);
        int sh = GetSystemMetrics(SM_CYSCREEN);

        g_hwnd = CreateWindowExA(
            WS_EX_TOPMOST | WS_EX_TRANSPARENT | WS_EX_LAYERED | WS_EX_TOOLWINDOW,
            "NullWareD3D11", "NullWare",
            WS_POPUP, 0, 0, sw, sh,
            nullptr, nullptr, GetModuleHandle(nullptr), nullptr);
        if (!g_hwnd) return false;

        SetLayeredWindowAttributes(g_hwnd, RGB(0, 0, 0), 0, LWA_COLORKEY);
        MARGINS margins = { -1 };
        DwmExtendFrameIntoClientArea(g_hwnd, &margins);

        gOverlay = g_hwnd;
        gW = sw; gH = sh;
        return Init(g_hwnd);
    }
}