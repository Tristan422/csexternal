inline void fillRect(float x1,float y1,float x2,float y2,COLORREF c) {
    HBRUSH b=GdiCache::getBrush(c); RECT r{(LONG)x1,(LONG)y1,(LONG)x2,(LONG)y2}; FillRect(gMemDC,&r,b);
}
inline void strokeRect(float x1,float y1,float x2,float y2,COLORREF c,int t) {
    HPEN p=GdiCache::getPen(c,t,PS_SOLID);
    HPEN op=(HPEN)SelectObject(gMemDC,p);
    HBRUSH ob=(HBRUSH)SelectObject(gMemDC,GetStockObject(NULL_BRUSH));
    Rectangle(gMemDC,(int)x1,(int)y1,(int)x2,(int)y2);
    SelectObject(gMemDC,op); SelectObject(gMemDC,ob);
}
inline void line(float x1,float y1,float x2,float y2,COLORREF c,int t) {
    HPEN p=GdiCache::getPen(c,t,PS_SOLID);
    HPEN op=(HPEN)SelectObject(gMemDC,p);
    MoveToEx(gMemDC,(int)x1,(int)y1,nullptr); LineTo(gMemDC,(int)x2,(int)y2);
    SelectObject(gMemDC,op);
}
inline void text(float x,float y,const char* s,COLORREF c,int sz,int weight) {
    HFONT f=GdiCache::getFont(sz,weight);
    HFONT old=(HFONT)SelectObject(gMemDC,f);
    SetTextColor(gMemDC,c); SetBkMode(gMemDC,TRANSPARENT);
    TextOutA(gMemDC,(int)x,(int)y,s,(int)strlen(s));
    SelectObject(gMemDC,old);
}
inline int textWidth(const char* s,int sz,int weight) {
    HFONT f=GdiCache::getFont(sz,weight);
    HFONT old=(HFONT)SelectObject(gMemDC,f);
    SIZE ss; GetTextExtentPoint32A(gMemDC,s,(int)strlen(s),&ss);
    SelectObject(gMemDC,old); return ss.cx;
}
inline bool over(int mx,int my,int x,int y,int w,int h) { return mx>=x && mx<x+w && my>=y && my<y+h; }
inline void circle(float cx,float cy,float r,COLORREF c) {
    HBRUSH b=GdiCache::getBrush(c); HPEN p=GdiCache::getPen(c,1,PS_SOLID);
    HBRUSH ob=(HBRUSH)SelectObject(gMemDC,b); HPEN op=(HPEN)SelectObject(gMemDC,p);
    Ellipse(gMemDC,(int)(cx-r),(int)(cy-r),(int)(cx+r),(int)(cy+r));
    SelectObject(gMemDC,ob); SelectObject(gMemDC,op);
}
inline void ellipseFilled(float cx,float cy,float rx,float ry,COLORREF c) {
    HBRUSH b=GdiCache::getBrush(c); HPEN p=GdiCache::getPen(c,1,PS_SOLID);
    HBRUSH ob=(HBRUSH)SelectObject(gMemDC,b); HPEN op=(HPEN)SelectObject(gMemDC,p);
    Ellipse(gMemDC,(int)(cx-rx),(int)(cy-ry),(int)(cx+rx),(int)(cy+ry));
    SelectObject(gMemDC,ob); SelectObject(gMemDC,op);
}

inline void topTab(const char* label,int idx,int x,int y) {
    int w=textWidth(label,14,idx==gTopTab?FW_SEMIBOLD:FW_NORMAL)+36;
    bool active=(gTopTab==idx);
    bool hover=over(gInput.mouse.x,gInput.mouse.y,x,y,w,TOPBAR_H);
    if (active) { text((float)(x+18),(float)(y+13),label,T::accent,14,FW_SEMIBOLD);
        fillRect((float)x,(float)(y+TOPBAR_H-3),(float)(x+w),(float)(y+TOPBAR_H),T::accent); }
    else if (hover) text((float)(x+18),(float)(y+13),label,T::text,14,FW_NORMAL);
    else text((float)(x+18),(float)(y+13),label,T::textMuted,14,FW_NORMAL);
    if (hover && gInput.lmbJustPressed) gTopTab=idx;
}
inline void subTab(const char* label,int idx,int x,int y,int w) {
    bool active=(gSubTab==idx);
    bool hover=over(gInput.mouse.x,gInput.mouse.y,x,y,w,34);
    if (active) { fillRect((float)x,(float)y,(float)(x+w),(float)(y+34),T::panelHover);
        fillRect((float)x,(float)y,(float)(x+3),(float)(y+34),T::accent);
        text((float)(x+22),(float)(y+9),label,T::text,13,FW_SEMIBOLD); }
    else if (hover) { fillRect((float)x,(float)y,(float)(x+w),(float)(y+34),T::panelAlt);
        text((float)(x+22),(float)(y+9),label,T::text,13,FW_NORMAL); }
    else text((float)(x+22),(float)(y+9),label,T::textMuted,13,FW_NORMAL);
    if (hover && gInput.lmbJustPressed) gSubTab=idx;
}
inline void sectionHeader(const char* label,int x,int y,int w) {
    text((float)(x+16),(float)y,label,T::textMuted,11,FW_SEMIBOLD);
    line((float)(x+16),(float)(y+22),(float)(x+w-16),(float)(y+22),T::divider,1);
}
inline void checkboxRow(const char* label,bool* val,int x,int y,int w) {
    bool hover=over(gInput.mouse.x,gInput.mouse.y,x,y,w,30);
    if (hover) fillRect((float)(x+8),(float)y,(float)(x+w-8),(float)(y+30),T::panelHover);
    int bx=x+16, by=y+8;
    fillRect((float)bx,(float)by,(float)(bx+14),(float)(by+14),T::track);
    strokeRect((float)bx,(float)by,(float)(bx+14),(float)(by+14),hover?T::borderLight:T::border,1);
    if (*val) fillRect((float)(bx+3),(float)(by+3),(float)(bx+11),(float)(by+11),T::accent);
    text((float)(x+42),(float)(y+5),label,hover?T::text:T::textMuted,13,FW_NORMAL);
    if (hover && gInput.lmbJustPressed) *val=!*val;
}
inline void sliderRow(const char* label,float* val,float minV,float maxV,int dec,int x,int y,int w) {
    bool hover=over(gInput.mouse.x,gInput.mouse.y,x,y,w,44);
    if (hover) fillRect((float)(x+8),(float)y,(float)(x+w-8),(float)(y+44),T::panelHover);
    text((float)(x+16),(float)(y+6),label,T::textMuted,12,FW_NORMAL);
    char buf[32]; if (dec==0) sprintf_s(buf,"%.0f",*val); else if (dec==1) sprintf_s(buf,"%.1f",*val);
    else if (dec==2) sprintf_s(buf,"%.2f",*val); else sprintf_s(buf,"%.3f",*val);
    int vw=textWidth(buf,12,FW_SEMIBOLD); text((float)(x+w-vw-16),(float)(y+6),buf,T::text,12,FW_SEMIBOLD);
    int bx=x+16, by=y+28, bw=w-32, bh=6;
    fillRect((float)bx,(float)by,(float)(bx+bw),(float)(by+bh),T::track);
    float t=(*val-minV)/(maxV-minV); if (t<0) t=0; if (t>1) t=1;
    int fillW=(int)(bw*t); fillRect((float)bx,(float)by,(float)(bx+fillW),(float)(by+bh),T::accent);
    float kx=(t>0.01f)?(float)(bx+fillW):(float)bx;
    circle(kx,(float)(by+bh/2.0f),6.5f,T::accentBright);
    bool bh_hover=over(gInput.mouse.x,gInput.mouse.y,bx,by-6,bw,18);
    if (bh_hover && gInput.lmbJustPressed) gSliderDrag=true;
    if (gSliderDrag && !gInput.lmbDown) gSliderDrag=false;
    if (gSliderDrag && gInput.lmbDown) { float nt=(float)(gInput.mouse.x-bx)/(float)bw;
        if (nt<0) nt=0; if (nt>1) nt=1; *val=minV+nt*(maxV-minV); }
}
inline void sliderRowInt(const char* label,int* val,int minV,int maxV,int x,int y,int w) {
    float tmp=(float)*val; sliderRow(label,&tmp,(float)minV,(float)maxV,0,x,y,w);
    *val=(int)tmp; if (*val<minV)*val=minV; if (*val>maxV)*val=maxV;
}
inline void radioRow(const char* label,int idx,int* target,int x,int y,int w) {
    bool selected=(*target==idx); bool hover=over(gInput.mouse.x,gInput.mouse.y,x,y,w,30);
    if (selected) { fillRect((float)(x+8),(float)y,(float)(x+w-8),(float)(y+30),T::panelHover);
        fillRect((float)(x+8),(float)y,(float)(x+11),(float)(y+30),T::accent); }
    else if (hover) fillRect((float)(x+8),(float)y,(float)(x+w-8),(float)(y+30),T::panelAlt);
    int cx=x+28, cy=y+15;
    circle((float)cx,(float)cy,7.0f,selected?T::accent:T::track);
    if (selected) circle((float)cx,(float)cy,3.0f,T::panel);
    text((float)(x+44),(float)(y+6),label,selected?T::text:T::textMuted,13,selected?FW_SEMIBOLD:FW_NORMAL);
    if (hover && gInput.lmbJustPressed) *target=idx;
}
inline void dropdownRow(const char* label,const char** options,int count,int* idx,int x,int y,int w) {
    bool hover=over(gInput.mouse.x,gInput.mouse.y,x,y,w,32);
    if (hover) fillRect((float)(x+8),(float)y,(float)(x+w-8),(float)(y+32),T::panelHover);
    text((float)(x+16),(float)(y+8),label,T::textMuted,13,FW_NORMAL);
    int boxX=x+w-180, boxW=168;
    fillRect((float)boxX,(float)(y+6),(float)(boxX+boxW),(float)(y+26),T::panelAlt);
    strokeRect((float)boxX,(float)(y+6),(float)(boxX+boxW),(float)(y+26),hover?T::borderLight:T::border,1);
    text((float)(boxX+10),(float)(y+7),options[*idx],T::text,12,FW_NORMAL);
    text((float)(boxX+boxW-14),(float)(y+7),"v",T::textMuted,11,FW_NORMAL);
    if (hover && gInput.lmbJustPressed) *idx=(*idx+1)%count;
}

inline void drawMenu() {
    int mx=gMenuX, my=gMenuY;
    fillRect((float)mx,(float)my,(float)(mx+MENU_W),(float)(my+MENU_H),T::bg);
    strokeRect((float)mx,(float)my,(float)(mx+MENU_W),(float)(my+MENU_H),T::border,1);
    fillRect((float)mx,(float)my,(float)(mx+MENU_W),(float)(my+TOPBAR_H),T::topBar);
    line((float)mx,(float)(my+TOPBAR_H),(float)(mx+MENU_W),(float)(my+TOPBAR_H),T::border,1);

    int tx=mx+18;
    const char* tabs[]={"About","Visuals","Chams","Combat","Misc","Skin"};
    for (int i=0;i<6;i++) { topTab(tabs[i],i,tx,my); tx+=textWidth(tabs[i],14,FW_NORMAL)+36; }

    bool hoverX=over(gInput.mouse.x,gInput.mouse.y,mx+MENU_W-40,my+10,26,26);
    if (hoverX) fillRect((float)(mx+MENU_W-40),(float)(my+10),(float)(mx+MENU_W-14),(float)(my+36),T::dangerHover);
    text((float)(mx+MENU_W-32),(float)(my+11),"x",hoverX?RGB(255,255,255):T::textMuted,16,FW_SEMIBOLD);
    if (hoverX && gInput.lmbJustPressed) { gMenuOpen=false;
        LONG_PTR ex=GetWindowLongPtr(gOverlay,GWL_EXSTYLE); ex|=WS_EX_TRANSPARENT;
        SetWindowLongPtr(gOverlay,GWL_EXSTYLE,ex); return; }

    int sideTop=my+TOPBAR_H, sideBot=my+MENU_H-BOTTOM_H;
    fillRect((float)mx,(float)sideTop,(float)(mx+SIDEBAR_W),(float)sideBot,T::sidebar);
    line((float)(mx+SIDEBAR_W),(float)sideTop,(float)(mx+SIDEBAR_W),(float)sideBot,T::border,1);
    int sidebarY=sideTop+14;
    text((float)(mx+18),(float)sidebarY,"NullWare",T::text,17,FW_SEMIBOLD);
    text((float)(mx+18),(float)(sidebarY+24),"v15.0",T::textDim,11,FW_NORMAL);
    sidebarY+=52;
    line((float)(mx+14),(float)sidebarY,(float)(mx+SIDEBAR_W-14),(float)sidebarY,T::divider,1);
    sidebarY+=14;

    const char* subLabels[4]={nullptr,nullptr,nullptr,nullptr}; int subCount=0;
    if (gTopTab==1){subLabels[0]="ESP";subLabels[1]="Extra";subCount=2;}
    else if (gTopTab==2){subLabels[0]="Chams";subCount=1;}
    else if (gTopTab==3){subLabels[0]="Trigger Bot";subCount=1;}
    else if (gTopTab==4){subLabels[0]="Info";subCount=1;}
    else if (gTopTab==5){subLabels[0]="Skins";subCount=1;}
    else {subLabels[0]="About";subCount=1;}
    for (int i=0;i<subCount;i++){subTab(subLabels[i],i,mx+4,sidebarY,SIDEBAR_W-8);sidebarY+=36;}

    int contentX=mx+SIDEBAR_W+18, contentY=my+TOPBAR_H+18;
    int contentW=MENU_W-SIDEBAR_W-36, colGap=18;
    int colW=(contentW-colGap)/2, col1X=contentX, col2X=contentX+colW+colGap;

    if (gTopTab==0) {
        sectionHeader("NullWare",col1X,contentY,contentW);
        int yy=contentY+32;
        text((float)col1X,(float)yy,"External CS2 - GDI Renderer",T::text,15,FW_SEMIBOLD);yy+=26;
        text((float)col1X,(float)yy,"Build 14181",T::textMuted,12,FW_NORMAL);yy+=20;
        text((float)col1X,(float)yy,"GDI cached + Skinchanger",T::textMuted,12,FW_NORMAL);yy+=34;
        text((float)col1X,(float)yy,"Controls",T::text,14,FW_SEMIBOLD);yy+=24;
        text((float)col1X,(float)yy,"DELETE -> toggle menu",T::textMuted,12,FW_NORMAL);yy+=20;
        text((float)col1X,(float)yy,"Click V/I -> set color",T::textMuted,12,FW_NORMAL);
    }
    else if (gTopTab==1) {
        if (gSubTab==0) {
            sectionHeader("ESP Features",col1X,contentY,colW);
            sectionHeader("Modifiers",col2X,contentY,colW);
            int rowY=contentY+32;
            checkboxRow("Box ESP",&gMenu.box,col1X,rowY,colW);rowY+=30;
            checkboxRow("Box Filled",&gMenu.boxFilled,col1X,rowY,colW);rowY+=30;
            checkboxRow("Health Bar",&gMenu.health,col1X,rowY,colW);rowY+=30;
            checkboxRow("Name",&gMenu.name,col1X,rowY,colW);rowY+=30;
            checkboxRow("Distance",&gMenu.distance,col1X,rowY,colW);rowY+=30;
            checkboxRow("Skeleton",&gMenu.skeleton,col1X,rowY,colW);rowY+=30;
            checkboxRow("Snapline",&gMenu.snapline,col1X,rowY,colW);
        } else {
            sectionHeader("Extra",col1X,contentY,colW);
            int rowY=contentY+32;
            checkboxRow("Full Box Style",&gMenu.fullBox,col1X,rowY,colW);rowY+=30;
            checkboxRow("Team Check",&gMenu.teamCheck,col1X,rowY,colW);
        }
    }
    else if (gTopTab==2) {
        sectionHeader("Chams Style",col1X,contentY,colW);
        int rowY=contentY+32;
        radioRow("Off",0,&gMenu.chamsStyle,col1X,rowY,colW);rowY+=30;
        radioRow("Latex",1,&gMenu.chamsStyle,col1X,rowY,colW);rowY+=30;
        radioRow("Flat",2,&gMenu.chamsStyle,col1X,rowY,colW);rowY+=30;
        radioRow("Glass",3,&gMenu.chamsStyle,col1X,rowY,colW);rowY+=30;
        radioRow("Glow",4,&gMenu.chamsStyle,col1X,rowY,colW);
    }
    else if (gTopTab==3) {
        sectionHeader("Trigger Bot",col1X,contentY,colW);
        int rowY=contentY+32;
        checkboxRow("Enable Trigger Bot",&gCombat.triggerBot,col1X,rowY,colW);rowY+=34;
        rowY+=10;
        text((float)(col1X+16),(float)rowY,"Trigger Key:",T::text,12,FW_SEMIBOLD);rowY+=24;
        dropdownRow("Key",gTriggerKeyNames,gTriggerKeyCount,&gCombat.triggerKey,col1X,rowY,colW);rowY+=38;
        rowY+=14;
        checkboxRow("Team Check",&gCombat.teamCheck,col1X,rowY,colW);rowY+=30;
        checkboxRow("Only Visible",&gCombat.visCheck,col1X,rowY,colW);rowY+=30;
        rowY+=14;
        checkboxRow("Seed Trigger",&gCombat.useSeedTrigger,col1X,rowY,colW);
    }
    else if (gTopTab==4) {
        sectionHeader("Status",col1X,contentY,colW);
        int rowY=contentY+32;
        circle((float)(col1X+26),(float)(rowY+8),5.5f,gAttachedToCs2?T::success:T::danger);
        text((float)(col1X+42),(float)rowY,gAttachedToCs2?"Attached to cs2.exe":"Waiting for cs2.exe",
             gAttachedToCs2?T::text:T::textMuted,13,FW_SEMIBOLD);rowY+=32;
        bool focused=gCs2Hwnd && IsWindow(gCs2Hwnd);
        circle((float)(col1X+26),(float)(rowY+8),5.5f,focused?T::success:T::warning);
        text((float)(col1X+42),(float)rowY,focused?"CS2 focused":"CS2 not focused",
             focused?T::text:T::textMuted,13,FW_SEMIBOLD);rowY+=44;
        text((float)(col1X+16),(float)rowY,"Build: 14181",T::text,13,FW_SEMIBOLD);rowY+=24;
        text((float)(col1X+16),(float)rowY,"Renderer: GDI cached",T::textMuted,12,FW_NORMAL);rowY+=22;
        text((float)(col1X+16),(float)rowY,"Skinchanger: CS2 offsets",T::textMuted,12,FW_NORMAL);
    }
    else if (gTopTab==5) {
        sectionHeader("Skinchanger",col1X,contentY,colW);
        sectionHeader("Preview",col2X,contentY,colW);
        int rowY=contentY+32, rY=contentY+32;

        checkboxRow("Enable Skinchanger",&gSkinChanger->enabled,col1X,rowY,colW);rowY+=34;

        text((float)(col1X+16),(float)rowY,"Selected Skin:",T::textMuted,12,FW_SEMIBOLD);rowY+=20;
        fillRect((float)(col1X+16),(float)rowY,(float)(col1X+colW-16),(float)(rowY+30),T::panelAlt);
        strokeRect((float)(col1X+16),(float)rowY,(float)(col1X+colW-16),(float)(rowY+30),T::border,1);
        { char buf[128]; sprintf_s(buf,"%s | %s",gSkinChanger->currentWeaponName(),gSkinChanger->currentSkinName());
          text((float)(col1X+24),(float)(rowY+7),buf,T::text,12,FW_NORMAL); }
        bool hL=over(gInput.mouse.x,gInput.mouse.y,col1X+16,rowY+34,30,24);
        bool hR=over(gInput.mouse.x,gInput.mouse.y,col1X+colW-46,rowY+34,30,24);
        if (hL) fillRect((float)(col1X+16),(float)(rowY+34),(float)(col1X+46),(float)(rowY+58),T::panelHover);
        if (hR) fillRect((float)(col1X+colW-46),(float)(rowY+34),(float)(col1X+colW-16),(float)(rowY+58),T::panelHover);
        text((float)(col1X+26),(float)(rowY+37),"<",T::text,14,FW_SEMIBOLD);
        text((float)(col1X+colW-38),(float)(rowY+37),">",T::text,14,FW_SEMIBOLD);
        if (hL && gInput.lmbJustPressed) { gSkinChanger->selectedSkinIdx--; if (gSkinChanger->selectedSkinIdx<0) gSkinChanger->selectedSkinIdx=g_skinCount-1; }
        if (hR && gInput.lmbJustPressed) { gSkinChanger->selectedSkinIdx++; if (gSkinChanger->selectedSkinIdx>=g_skinCount) gSkinChanger->selectedSkinIdx=0; }
        rowY+=70;

        sliderRow("Wear",&gSkinChanger->wear,0.0f,1.0f,3,col1X,rowY,colW);rowY+=48;
        sliderRowInt("Pattern Seed",&gSkinChanger->seed,0,1000,col1X,rowY,colW);rowY+=48;
        checkboxRow("StatTrak",&gSkinChanger->statTrak,col1X,rowY,colW);rowY+=30;
        if (gSkinChanger->statTrak) { sliderRowInt("Kill Count",&gSkinChanger->statTrakKills,0,9999,col1X,rowY,colW); }

        text((float)(col2X+16),(float)rY,"Current Loadout",T::text,14,FW_SEMIBOLD);rY+=28;
        { char wbuf[64],sbuf[64];
          sprintf_s(wbuf,"Weapon: %s",gSkinChanger->currentWeaponName());
          sprintf_s(sbuf,"Skin:   %s",gSkinChanger->currentSkinName());
          text((float)(col2X+16),(float)rY,wbuf,T::textMuted,13,FW_NORMAL);rY+=22;
          text((float)(col2X+16),(float)rY,sbuf,T::textMuted,13,FW_NORMAL);rY+=22;
          char pbuf[64]; sprintf_s(pbuf,"PaintKit: %d",g_skinList[gSkinChanger->selectedSkinIdx].paintKit);
          text((float)(col2X+16),(float)rY,pbuf,T::textDim,11,FW_NORMAL);rY+=30; }
        text((float)(col2X+16),(float)rY,"Client-side visual only.",T::warning,11,FW_NORMAL);
    }

    int by=my+MENU_H-BOTTOM_H;
    fillRect((float)mx,(float)by,(float)(mx+MENU_W),(float)(my+MENU_H),T::topBar);
    line((float)mx,(float)by,(float)(mx+MENU_W),(float)by,T::border,1);
    COLORREF statCol=T::danger; const char* statTxt="Detached";
    if (gAttachedToCs2) { if (gCs2Hwnd && IsWindow(gCs2Hwnd)) { statCol=T::success; statTxt="Live"; } else { statCol=T::warning; statTxt="Idle"; } }
    circle((float)(mx+20),(float)(by+16),4.5f,statCol);
    text((float)(mx+34),(float)(by+9),statTxt,T::textMuted,12,FW_NORMAL);
    text((float)(mx+MENU_W-80),(float)(by+9),"NullWare",T::accent,12,FW_SEMIBOLD);
}

inline void updateMenuInput() {
    if (!gMenuOpen||gPickerOpen) return;
    bool inTop=over(gInput.mouse.x,gInput.mouse.y,gMenuX,gMenuY,MENU_W,TOPBAR_H);
    bool onClose=over(gInput.mouse.x,gInput.mouse.y,gMenuX+MENU_W-40,gMenuY+10,26,26);
    if (gInput.lmbJustPressed && inTop && !onClose) {
        gMenuDragging=true; gMenuDragOffset.x=gInput.mouse.x-gMenuX; gMenuDragOffset.y=gInput.mouse.y-gMenuY;
    }
    if (!gInput.lmbDown) gMenuDragging=false;
    if (gMenuDragging) { gMenuX=gInput.mouse.x-gMenuDragOffset.x; gMenuY=gInput.mouse.y-gMenuDragOffset.y; }
}