// ---- Primitive helpers ----
inline void fillRect(float x1,float y1,float x2,float y2,COLORREF c) {
    // AXOMJB: cached brush, no per-call alloc
    HBRUSH b = GdiCache::getBrush(c);
    RECT r{ (LONG)x1,(LONG)y1,(LONG)x2,(LONG)y2 };
    FillRect(gMemDC, &r, b);
}

inline void strokeRect(float x1,float y1,float x2,float y2,COLORREF c,int t) {
    HPEN p = GdiCache::getPen(c, t, PS_SOLID);
    HPEN op = (HPEN)SelectObject(gMemDC, p);
    HBRUSH ob = (HBRUSH)SelectObject(gMemDC, GetStockObject(NULL_BRUSH));
    Rectangle(gMemDC, (int)x1, (int)y1, (int)x2, (int)y2);
    SelectObject(gMemDC, op);
    SelectObject(gMemDC, ob);
}

inline void line(float x1,float y1,float x2,float y2,COLORREF c,int t) {
    HPEN p = GdiCache::getPen(c, t, PS_SOLID);
    HPEN op = (HPEN)SelectObject(gMemDC, p);
    MoveToEx(gMemDC, (int)x1, (int)y1, nullptr);
    LineTo(gMemDC, (int)x2, (int)y2);
    SelectObject(gMemDC, op);
}

inline void text(float x,float y,const char* s,COLORREF c,int sz,int weight) {
    HFONT f = GdiCache::getFont(sz, weight);
    HFONT old = (HFONT)SelectObject(gMemDC, f);
    SetTextColor(gMemDC, c);
    SetBkMode(gMemDC, TRANSPARENT);
    TextOutA(gMemDC, (int)x, (int)y, s, (int)strlen(s));
    SelectObject(gMemDC, old);
}

inline int textWidth(const char* s,int sz,int weight) {
    HFONT f = GdiCache::getFont(sz, weight);
    HFONT old = (HFONT)SelectObject(gMemDC, f);
    SIZE ss; GetTextExtentPoint32A(gMemDC, s, (int)strlen(s), &ss);
    SelectObject(gMemDC, old);
    return ss.cx;
}
inline bool over(int mx,int my,int x,int y,int w,int h) {
    return mx>=x && mx<x+w && my>=y && my<y+h;
}
inline void circle(float cx,float cy,float r,COLORREF c) {
    HBRUSH b = GdiCache::getBrush(c);
    HPEN   p = GdiCache::getPen(c, 1, PS_SOLID);
    HBRUSH ob = (HBRUSH)SelectObject(gMemDC, b);
    HPEN   op = (HPEN)SelectObject(gMemDC, p);
    Ellipse(gMemDC, (int)(cx-r), (int)(cy-r), (int)(cx+r), (int)(cy+r));
    SelectObject(gMemDC, ob);
    SelectObject(gMemDC, op);
}
inline void ellipseFilled(float cx,float cy,float rx,float ry,COLORREF c) {
    HBRUSH b = GdiCache::getBrush(c);
    HPEN   p = GdiCache::getPen(c, 1, PS_SOLID);
    HBRUSH ob = (HBRUSH)SelectObject(gMemDC, b);
    HPEN   op = (HPEN)SelectObject(gMemDC, p);
    Ellipse(gMemDC, (int)(cx-rx), (int)(cy-ry), (int)(cx+rx), (int)(cy+ry));
    SelectObject(gMemDC, ob);
    SelectObject(gMemDC, op);
}

// ---- Widgets ----
inline void topTab(const char* label,int idx,int x,int y) {
    int w=textWidth(label,14,idx==gTopTab?FW_SEMIBOLD:FW_NORMAL) + 36;
    bool active=(gTopTab==idx);
    bool hover=over(gInput.mouse.x,gInput.mouse.y,x,y,w,TOPBAR_H);
    if (active) {
        text((float)(x+18),(float)(y+13), label, T::accent, 14, FW_SEMIBOLD);
        fillRect((float)x,(float)(y+TOPBAR_H-3),(float)(x+w),(float)(y+TOPBAR_H), T::accent);
    } else if (hover) text((float)(x+18),(float)(y+13), label, T::text, 14, FW_NORMAL);
    else text((float)(x+18),(float)(y+13), label, T::textMuted, 14, FW_NORMAL);
    if (hover && gInput.lmbJustPressed) gTopTab=idx;
}
inline void subTab(const char* label,int idx,int x,int y,int w) {
    bool active=(gSubTab==idx);
    bool hover=over(gInput.mouse.x,gInput.mouse.y,x,y,w,34);
    if (active) {
        fillRect((float)x,(float)y,(float)(x+w),(float)(y+34), T::panelHover);
        fillRect((float)x,(float)y,(float)(x+3),(float)(y+34), T::accent);
        text((float)(x+22),(float)(y+9), label, T::text, 13, FW_SEMIBOLD);
    } else if (hover) {
        fillRect((float)x,(float)y,(float)(x+w),(float)(y+34), T::panelAlt);
        text((float)(x+22),(float)(y+9), label, T::text, 13, FW_NORMAL);
    } else text((float)(x+22),(float)(y+9), label, T::textMuted, 13, FW_NORMAL);
    if (hover && gInput.lmbJustPressed) gSubTab=idx;
}
inline void sectionHeader(const char* label,int x,int y,int w) {
    text((float)(x+16),(float)y, label, T::textMuted, 11, FW_SEMIBOLD);
    line((float)(x+16),(float)(y+22),(float)(x+w-16),(float)(y+22), T::divider, 1);
}
inline void checkboxRow(const char* label,bool* val,int x,int y,int w) {
    bool hover=over(gInput.mouse.x,gInput.mouse.y,x,y,w,30);
    if (hover) fillRect((float)(x+8),(float)y,(float)(x+w-8),(float)(y+30), T::panelHover);
    int bx=x+16, by=y+8;
    fillRect((float)bx,(float)by,(float)(bx+14),(float)(by+14), T::track);
    strokeRect((float)bx,(float)by,(float)(bx+14),(float)(by+14), hover?T::borderLight:T::border, 1);
    if (*val) fillRect((float)(bx+3),(float)(by+3),(float)(bx+11),(float)(by+11), T::accent);
    text((float)(x+42),(float)(y+5), label, hover?T::text:T::textMuted, 13, FW_NORMAL);
    if (hover && gInput.lmbJustPressed) *val=!*val;
}
inline void checkboxRow2(const char* label,bool* val,
                         CustomColor* visCol, CustomColor* invCol,
                         int x,int y,int w) {
    int swW = 26, gap = 4;
    int invX = x + w - 12 - swW;
    int visX = invX - gap - swW;
    int cbEndX = visX - 8;
    bool hoverCB = over(gInput.mouse.x,gInput.mouse.y,x,y,cbEndX-x,30);
    bool hoverV  = over(gInput.mouse.x,gInput.mouse.y,visX,y+6,swW,18);
    bool hoverI  = over(gInput.mouse.x,gInput.mouse.y,invX,y+6,swW,18);
    if (hoverCB) fillRect((float)(x+8),(float)y,(float)cbEndX,(float)(y+30), T::panelHover);
    if (hoverV)  fillRect((float)(visX-2),(float)y,(float)(visX+swW+2),(float)(y+30), T::panelHover);
    if (hoverI)  fillRect((float)(invX-2),(float)y,(float)(invX+swW+2),(float)(y+30), T::panelHover);
    int bx=x+16, by=y+8;
    fillRect((float)bx,(float)by,(float)(bx+14),(float)(by+14), T::track);
    strokeRect((float)bx,(float)by,(float)(bx+14),(float)(by+14),
               (hoverCB||hoverV||hoverI)?T::borderLight:T::border, 1);
    if (*val) fillRect((float)(bx+3),(float)(by+3),(float)(bx+11),(float)(by+11), T::accent);
    text((float)(x+42),(float)(y+5), label,
         (hoverCB||hoverV||hoverI)?T::text:T::textMuted, 13, FW_NORMAL);
    fillRect((float)visX,(float)(y+6),(float)(visX+swW),(float)(y+24), visCol->toCOLORREF());
    strokeRect((float)visX,(float)(y+6),(float)(visX+swW),(float)(y+24),
               hoverV?T::accent:T::border, hoverV?2:1);
    fillRect((float)invX,(float)(y+6),(float)(invX+swW),(float)(y+24), invCol->toCOLORREF());
    strokeRect((float)invX,(float)(y+6),(float)(invX+swW),(float)(y+24),
               hoverI?T::accent:T::border, hoverI?2:1);
    if (gInput.lmbJustPressed) {
        if (hoverV) { gPickerOpen=true; gPickerRef=visCol; gPickerTitle="Visible";
            gPickerPos.x=gMenuX+MENU_W+12; gPickerPos.y=y; }
        else if (hoverI) { gPickerOpen=true; gPickerRef=invCol; gPickerTitle="Invisible";
            gPickerPos.x=gMenuX+MENU_W+12; gPickerPos.y=y; }
        else if (hoverCB) *val = !*val;
    }
}
inline void sliderRow(const char* label,float* val,float minV,float maxV,int dec,int x,int y,int w) {
    bool hover=over(gInput.mouse.x,gInput.mouse.y,x,y,w,44);
    if (hover) fillRect((float)(x+8),(float)y,(float)(x+w-8),(float)(y+44), T::panelHover);
    text((float)(x+16),(float)(y+6), label, T::textMuted, 12, FW_NORMAL);
    char buf[32];
    if (dec==0) sprintf_s(buf,"%.0f",*val);
    else if (dec==1) sprintf_s(buf,"%.1f",*val);
    else if (dec==2) sprintf_s(buf,"%.2f",*val);
    else sprintf_s(buf,"%.3f",*val);
    int vw=textWidth(buf,12,FW_SEMIBOLD);
    text((float)(x+w-vw-16),(float)(y+6), buf, T::text, 12, FW_SEMIBOLD);
    int bx=x+16, by=y+28, bw=w-32, bh=6;
    fillRect((float)bx,(float)by,(float)(bx+bw),(float)(by+bh), T::track);
    float t=(*val-minV)/(maxV-minV);
    if (t<0) t=0; if (t>1) t=1;
    int fillW=(int)(bw*t);
    fillRect((float)bx,(float)by,(float)(bx+fillW),(float)(by+bh), T::accent);
    float kx=(t>0.01f)?(float)(bx+fillW):(float)bx;
    circle(kx, (float)(by+bh/2.0f), 6.5f, T::accentBright);
    bool bh_hover=over(gInput.mouse.x,gInput.mouse.y,bx,by-6,bw,18);
    if (bh_hover && gInput.lmbJustPressed) gSliderDrag=true;
    if (gSliderDrag && !gInput.lmbDown) gSliderDrag=false;
    if (gSliderDrag && gInput.lmbDown) {
        float nt=(float)(gInput.mouse.x-bx)/(float)bw;
        if (nt<0) nt=0; if (nt>1) nt=1;
        *val=minV+nt*(maxV-minV);
    }
}
inline void sliderRowInt(const char* label,int* val,int minV,int maxV,int x,int y,int w) {
    float tmp = (float)*val;
    sliderRow(label, &tmp, (float)minV, (float)maxV, 0, x, y, w);
    *val = (int)tmp;
    if (*val < minV) *val = minV;
    if (*val > maxV) *val = maxV;
}
inline void radioRow(const char* label,int idx,int* target,int x,int y,int w) {
    bool selected = (*target == idx);
    bool hover = over(gInput.mouse.x,gInput.mouse.y,x,y,w,30);
    if (selected) {
        fillRect((float)(x+8),(float)y,(float)(x+w-8),(float)(y+30), T::panelHover);
        fillRect((float)(x+8),(float)y,(float)(x+11),(float)(y+30), T::accent);
    } else if (hover) fillRect((float)(x+8),(float)y,(float)(x+w-8),(float)(y+30), T::panelAlt);
    int cx = x+28, cy = y+15;
    circle((float)cx, (float)cy, 7.0f, selected ? T::accent : T::track);
    if (selected) circle((float)cx, (float)cy, 3.0f, T::panel);
    text((float)(x+44),(float)(y+6), label,
         selected?T::text:T::textMuted, 13,
         selected?FW_SEMIBOLD:FW_NORMAL);
    if (hover && gInput.lmbJustPressed) *target = idx;
}
inline void dropdownRow(const char* label,const char** options,int count,int* idx,int x,int y,int w) {
    bool hover = over(gInput.mouse.x,gInput.mouse.y,x,y,w,32);
    if (hover) fillRect((float)(x+8),(float)y,(float)(x+w-8),(float)(y+32), T::panelHover);
    text((float)(x+16),(float)(y+8), label, T::textMuted, 13, FW_NORMAL);
    int boxX = x + w - 180, boxW = 168;
    fillRect((float)boxX,(float)(y+6),(float)(boxX+boxW),(float)(y+26), T::panelAlt);
    strokeRect((float)boxX,(float)(y+6),(float)(boxX+boxW),(float)(y+26), hover?T::borderLight:T::border, 1);
    text((float)(boxX+10),(float)(y+7), options[*idx], T::text, 12, FW_NORMAL);
    text((float)(boxX+boxW-14),(float)(y+7), "v", T::textMuted, 11, FW_NORMAL);
    if (hover && gInput.lmbJustPressed) *idx = (*idx + 1) % count;
}

// ---- Color picker ----
inline void drawColorPicker() {
    if (!gPickerOpen||!gPickerRef) return;
    int px=gPickerPos.x, py=gPickerPos.y;
    int pw=270, ph=230;
    fillRect((float)px,(float)py,(float)(px+pw),(float)(py+ph), T::panel);
    strokeRect((float)px,(float)py,(float)(px+pw),(float)(py+ph), T::border, 1);
    fillRect((float)px,(float)py,(float)(px+pw),(float)(py+34), T::panelAlt);
    text((float)(px+16),(float)(py+9), gPickerTitle, T::text, 13, FW_SEMIBOLD);
    bool hX=over(gInput.mouse.x,gInput.mouse.y,px+pw-30,py+8,24,24);
    fillRect((float)(px+pw-28),(float)(py+8),(float)(px+pw-8),(float)(py+28), hX?T::danger:T::panelAlt);
    text((float)(px+pw-21),(float)(py+8), "x", T::text, 14, FW_SEMIBOLD);
    if (hX && gInput.lmbJustPressed) { gPickerOpen=false; return; }
    line((float)px,(float)(py+34),(float)(px+pw),(float)(py+34), T::border, 1);
    int cy=py+48;
    fillRect((float)(px+16),(float)cy,(float)(px+pw-16),(float)(cy+44), gPickerRef->toCOLORREF());
    strokeRect((float)(px+16),(float)cy,(float)(px+pw-16),(float)(cy+44), T::border, 1);
    char hex[16];
    sprintf_s(hex,"#%02X%02X%02X",
        (int)(gPickerRef->r*255),(int)(gPickerRef->g*255),(int)(gPickerRef->b*255));
    int lum=(int)(0.299f*gPickerRef->r*255+0.587f*gPickerRef->g*255+0.114f*gPickerRef->b*255);
    text((float)(px+22),(float)(cy+15), hex, (lum>128)?RGB(0,0,0):RGB(255,255,255), 14, FW_SEMIBOLD);
    cy += 58;
    const char* labels[3] = {"R","G","B"};
    for (int idx = 0; idx < 3; ++idx) {
        float* v = (idx==0) ? &gPickerRef->r : (idx==1) ? &gPickerRef->g : &gPickerRef->b;
        text((float)(px+16),(float)cy, labels[idx], T::textMuted, 12, FW_SEMIBOLD);
        int bx=px+40, bw=pw-120, by=cy+4, bh=16;
        for (int i=0;i<bw;i++) {
            float t=(float)i/(float)(bw-1);
            float r=gPickerRef->r,g=gPickerRef->g,b=gPickerRef->b;
            if (idx==0) r=t; else if (idx==1) g=t; else b=t;
            fillRect((float)(bx+i),(float)by,(float)(bx+i+1),(float)(by+bh),
                RGB((BYTE)(r*255),(BYTE)(g*255),(BYTE)(b*255)));
        }
        strokeRect((float)bx,(float)by,(float)(bx+bw),(float)(by+bh), T::border, 1);
        int kx=bx+(int)(*v*(bw-1));
        circle((float)kx,(float)(by+bh/2.0f), 7.0f, RGB(255,255,255));
        circle((float)kx,(float)(by+bh/2.0f), 7.0f, RGB(20,20,20));
        char val[16]; sprintf_s(val,"%d",(int)(*v*255));
        text((float)(px+pw-60),(float)(cy+4), val, T::text, 12, FW_NORMAL);
        bool hv=over(gInput.mouse.x,gInput.mouse.y,bx,by,bw,bh);
        if (hv && gInput.lmbJustPressed) { gSliderDrag=true; gSliderActive=idx; }
        if (gSliderDrag && gSliderActive==idx) {
            float t=(float)(gInput.mouse.x-bx)/(float)(bw-1);
            if (t<0) t=0; if (t>1) t=1;
            *v=t;
        }
        cy += 30;
    }
    if (!gInput.lmbDown) { gSliderDrag=false; gSliderActive=-1; }
}

// ---- Main menu ----
inline void drawMenu() {
    int mx=gMenuX, my=gMenuY;
    fillRect((float)mx,(float)my,(float)(mx+MENU_W),(float)(my+MENU_H), T::bg);
    strokeRect((float)mx,(float)my,(float)(mx+MENU_W),(float)(my+MENU_H), T::border, 1);
    fillRect((float)mx,(float)my,(float)(mx+MENU_W),(float)(my+TOPBAR_H), T::topBar);
    line((float)mx,(float)(my+TOPBAR_H),(float)(mx+MENU_W),(float)(my+TOPBAR_H), T::border, 1);

    int tx=mx+18;
    const char* tabs[] = {"About","Visuals","Chams","Combat","Misc"};
    for (int i=0;i<5;i++) {
        topTab(tabs[i], i, tx, my);
        tx += textWidth(tabs[i],14,FW_NORMAL)+36;
    }

    bool hoverX=over(gInput.mouse.x,gInput.mouse.y,mx+MENU_W-40,my+10,26,26);
    if (hoverX) fillRect((float)(mx+MENU_W-40),(float)(my+10),(float)(mx+MENU_W-14),(float)(my+36), T::dangerHover);
    text((float)(mx+MENU_W-32),(float)(my+11), "x", hoverX?RGB(255,255,255):T::textMuted, 16, FW_SEMIBOLD);
    if (hoverX && gInput.lmbJustPressed) {
        gMenuOpen=false;
        LONG_PTR ex=GetWindowLongPtr(gOverlay,GWL_EXSTYLE);
        ex |= WS_EX_TRANSPARENT;
        SetWindowLongPtr(gOverlay,GWL_EXSTYLE,ex);
        return;
    }

    int sideTop=my+TOPBAR_H;
    int sideBot=my+MENU_H-BOTTOM_H;
    fillRect((float)mx,(float)sideTop,(float)(mx+SIDEBAR_W),(float)sideBot, T::sidebar);
    line((float)(mx+SIDEBAR_W),(float)sideTop,(float)(mx+SIDEBAR_W),(float)sideBot, T::border, 1);

    int sidebarY=sideTop+14;
    text((float)(mx+18),(float)sidebarY, "NullWare", T::text, 17, FW_SEMIBOLD);
    text((float)(mx+18),(float)(sidebarY+24), "v14.0", T::textDim, 11, FW_NORMAL);
    sidebarY+=52;
    line((float)(mx+14),(float)sidebarY,(float)(mx+SIDEBAR_W-14),(float)sidebarY, T::divider, 1);
    sidebarY+=14;

    const char* subLabels[4] = {nullptr,nullptr,nullptr,nullptr};
    int subCount=0;
    if (gTopTab==1) { subLabels[0]="ESP"; subLabels[1]="Extra"; subCount=2; }
    else if (gTopTab==2) { subLabels[0]="Chams"; subCount=1; }
    else if (gTopTab==3) { subLabels[0]="Trigger Bot"; subCount=1; }
    else if (gTopTab==4) { subLabels[0]="Info"; subCount=1; }
    else { subLabels[0]="About"; subCount=1; }
    for (int i=0;i<subCount;i++) {
        subTab(subLabels[i], i, mx+4, sidebarY, SIDEBAR_W-8);
        sidebarY+=36;
    }

    int contentX=mx+SIDEBAR_W+18;
    int contentY=my+TOPBAR_H+18;
    int contentW=MENU_W-SIDEBAR_W-36;
    int colGap=18;
    int colW=(contentW-colGap)/2;
    int col1X=contentX, col2X=contentX+colW+colGap;

    if (gTopTab==0) {
        sectionHeader("NullWare", col1X, contentY, contentW);
        int yy=contentY+32;
        text((float)col1X,(float)yy, "External CS2 - ESP / Chams / Trigger", T::text, 15, FW_SEMIBOLD); yy+=26;
        text((float)col1X,(float)yy, "Build 14181", T::textMuted, 12, FW_NORMAL); yy+=20;
        text((float)col1X,(float)yy, "Chams: shellcode + vtable hook", T::textMuted, 12, FW_NORMAL); yy+=34;
        text((float)col1X,(float)yy, "Controls", T::text, 14, FW_SEMIBOLD); yy+=24;
        text((float)col1X,(float)yy, "DELETE  ->  toggle menu", T::textMuted, 12, FW_NORMAL); yy+=20;
        text((float)col1X,(float)yy, "Click label  ->  toggle feature", T::textMuted, 12, FW_NORMAL); yy+=20;
        text((float)col1X,(float)yy, "Click V/I  ->  set color", T::textMuted, 12, FW_NORMAL); yy+=34;
        text((float)col1X,(float)yy, "Features default OFF", T::accent, 12, FW_SEMIBOLD); yy+=24;
        text((float)col1X,(float)yy, "Only draws when CS2 is focused", T::warning, 11, FW_NORMAL);
    }
    else if (gTopTab==1) {
        if (gSubTab==0) {
            sectionHeader("ESP Features", col1X, contentY, colW);
            sectionHeader("Modifiers",    col2X, contentY, colW);
            int rowY=contentY+32, rY=contentY+32;
            checkboxRow2("Box ESP",     &gMenu.box,      &gMenu.boxColor,      &gMenu.boxColorI,      col1X,rowY,colW); rowY+=30;
            checkboxRow2("Box Filled",  &gMenu.boxFilled,&gMenu.filledColor,   &gMenu.filledColorI,   col1X,rowY,colW); rowY+=30;
            checkboxRow2("Health Bar",  &gMenu.health,   &gMenu.healthColor,   &gMenu.healthColorI,   col1X,rowY,colW); rowY+=30;
            checkboxRow2("Armor Bar",   &gMenu.armor,    &gMenu.armorColor,    &gMenu.armorColorI,    col1X,rowY,colW); rowY+=30;
            checkboxRow2("Name",        &gMenu.name,     &gMenu.nameColor,     &gMenu.nameColorI,     col1X,rowY,colW); rowY+=30;
            checkboxRow2("Distance",    &gMenu.distance, &gMenu.distanceColor, &gMenu.distanceColorI, col1X,rowY,colW); rowY+=30;
            checkboxRow2("Skeleton",    &gMenu.skeleton, &gMenu.skeletonColor, &gMenu.skeletonColorI, col1X,rowY,colW); rowY+=30;
            checkboxRow2("Snapline",    &gMenu.snapline, &gMenu.snaplineColor, &gMenu.snaplineColorI, col1X,rowY,colW); rowY+=30;
            checkboxRow2("Head Dot",    &gMenu.headDot,  &gMenu.skeletonColor, &gMenu.skeletonColorI, col1X,rowY,colW); rowY+=30;
            checkboxRow("Bone-Based Box", &gMenu.boxBoneBased, col1X, rowY, colW); rowY+=30;
            sliderRow("Box Padding X", &gMenu.boxBonePaddingX, 0.0f, 0.5f, 2, col2X, rY, colW); rY+=48;
            sliderRow("Box Padding Y", &gMenu.boxBonePaddingY, 0.0f, 0.3f, 2, col2X, rY, colW); rY+=48;
            sliderRow("Box Thickness", &gMenu.boxThickness,  1.0f, 6.0f,  0, col2X, rY, colW); rY+=48;
            sliderRow("Head Clearance",&gMenu.headClearance, 0.0f, 20.0f, 1, col2X, rY, colW); rY+=48;
            sliderRow("Head Fallback", &gMenu.headOffset,   40.0f,100.0f, 0, col2X, rY, colW); rY+=48;
        } else {
            sectionHeader("Extra", col1X, contentY, colW);
            int rowY=contentY+32;
            checkboxRow("Full Box Style", &gMenu.fullBox,   col1X, rowY, colW); rowY+=30;
            checkboxRow("Team Check",     &gMenu.teamCheck, col1X, rowY, colW); rowY+=30;
            checkboxRow("Precise Head",   &gMenu.useBone,   col1X, rowY, colW); rowY+=30;
        }
    }
    else if (gTopTab==2) {
        sectionHeader("Chams Style", col1X, contentY, colW);
        sectionHeader("Chams Options", col2X, contentY, colW);
        int rowY=contentY+32, rY=contentY+32;
        radioRow("Off",      0, &gMenu.chamsStyle, col1X, rowY, colW); rowY+=30;
        radioRow("Latex",    1, &gMenu.chamsStyle, col1X, rowY, colW); rowY+=30;
        radioRow("Flat",     2, &gMenu.chamsStyle, col1X, rowY, colW); rowY+=30;
        radioRow("Glass",    3, &gMenu.chamsStyle, col1X, rowY, colW); rowY+=30;
        radioRow("Glow",     4, &gMenu.chamsStyle, col1X, rowY, colW); rowY+=38;
        checkboxRow("Team Check", &gMenu.chamsTeamCheck, col1X, rowY, colW); rowY+=32;
        sliderRow("Color R", &gMenu.chamsColorR, 0.0f, 1.0f, 2, col2X, rY, colW); rY+=48;
        sliderRow("Color G", &gMenu.chamsColorG, 0.0f, 1.0f, 2, col2X, rY, colW); rY+=48;
        sliderRow("Color B", &gMenu.chamsColorB, 0.0f, 1.0f, 2, col2X, rY, colW); rY+=48;
        sliderRow("Alpha",   &gMenu.chamsColorA, 0.0f, 1.0f, 2, col2X, rY, colW); rY+=48;
    }
    else if (gTopTab==3) {
        sectionHeader("Trigger Bot", col1X, contentY, colW);
        sectionHeader("Settings",    col2X, contentY, colW);
        int rowY = contentY + 32, rY = contentY + 32;
        checkboxRow("Enable Trigger Bot", &gCombat.triggerBot, col1X, rowY, colW); rowY += 34;
        rowY += 10;
        text((float)(col1X+16),(float)rowY,"Trigger Key:",T::text,12,FW_SEMIBOLD); rowY+=24;
        dropdownRow("Key", gTriggerKeyNames, gTriggerKeyCount, &gCombat.triggerKey, col1X, rowY, colW); rowY += 38;
        rowY += 14;
        checkboxRow("Team Check",    &gCombat.teamCheck, col1X, rowY, colW); rowY+=30;
        checkboxRow("Only Visible",  &gCombat.visCheck,  col1X, rowY, colW); rowY+=30;
        rowY += 14;
        checkboxRow("Seed Trigger",  &gCombat.useSeedTrigger, col1X, rowY, colW); rowY+=30;
        sliderRow("Hit Chance", &gCombat.hitChance, 0.5f, 1.0f, 2, col2X, rY, colW); rY += 48;
        sliderRowInt("Delay (ms)",    &gCombat.delayMs,    0, 300, col2X, rY, colW); rY += 48;
        sliderRowInt("Hold Time (ms)", &gCombat.holdMs,     5, 200, col2X, rY, colW); rY += 48;
        sliderRowInt("Cooldown (ms)", &gCombat.cooldownMs, 10, 1000, col2X, rY, colW); rY += 48;
    }
    else if (gTopTab==4) {
        sectionHeader("Status", col1X, contentY, colW);
        int rowY=contentY+32;
        circle((float)(col1X+26),(float)(rowY+8), 5.5f, gAttachedToCs2?T::success:T::danger);
        text((float)(col1X+42),(float)rowY, gAttachedToCs2 ? "Attached to cs2.exe" : "Waiting for cs2.exe",
             gAttachedToCs2?T::text:T::textMuted, 13, FW_SEMIBOLD); rowY+=32;
        bool focused = gCs2Hwnd && IsWindow(gCs2Hwnd);
        circle((float)(col1X+26),(float)(rowY+8), 5.5f, focused?T::success:T::warning);
        text((float)(col1X+42),(float)rowY, focused?"CS2 focused":"CS2 not focused",
             focused?T::text:T::textMuted, 13, FW_SEMIBOLD); rowY+=44;
        text((float)(col1X+16),(float)rowY,"Build: 14181",T::text,13,FW_SEMIBOLD); rowY+=24;
        text((float)(col1X+16),(float)rowY,"Chams: shellcode + vtable",T::textMuted,12,FW_NORMAL); rowY+=22;
        text((float)(col1X+16),(float)rowY,"Material: csgo_character.vfx",T::textMuted,12,FW_NORMAL); rowY+=22;
        text((float)(col1X+16),(float)rowY,"DELETE to toggle menu",T::textMuted,12,FW_NORMAL);
    }

    int by=my+MENU_H-BOTTOM_H;
    fillRect((float)mx,(float)by,(float)(mx+MENU_W),(float)(my+MENU_H), T::topBar);
    line((float)mx,(float)by,(float)(mx+MENU_W),(float)by, T::border, 1);
    COLORREF statCol = T::danger; const char* statTxt = "Detached";
    if (gAttachedToCs2) {
        if (gCs2Hwnd && IsWindow(gCs2Hwnd)) { statCol = T::success; statTxt = "Live"; }
        else { statCol = T::warning; statTxt = "Idle"; }
    }
    circle((float)(mx+20),(float)(by+16), 4.5f, statCol);
    text((float)(mx+34),(float)(by+9), statTxt, T::textMuted, 12, FW_NORMAL);
    text((float)(mx+MENU_W-80),(float)(by+9), "NullWare", T::accent, 12, FW_SEMIBOLD);

    if (gPickerOpen) drawColorPicker();
}

inline void updateMenuInput() {
    if (!gMenuOpen||gPickerOpen) return;
    bool inTop=over(gInput.mouse.x,gInput.mouse.y,gMenuX,gMenuY,MENU_W,TOPBAR_H);
    bool onClose=over(gInput.mouse.x,gInput.mouse.y,gMenuX+MENU_W-40,gMenuY+10,26,26);
    if (gInput.lmbJustPressed && inTop && !onClose) {
        gMenuDragging=true;
        gMenuDragOffset.x=gInput.mouse.x-gMenuX;
        gMenuDragOffset.y=gInput.mouse.y-gMenuY;
    }
    if (!gInput.lmbDown) gMenuDragging=false;
    if (gMenuDragging) {
        gMenuX=gInput.mouse.x-gMenuDragOffset.x;
        gMenuY=gInput.mouse.y-gMenuDragOffset.y;
    }
}
