constexpr int g_skinCount = sizeof(g_skinList) / sizeof(g_skinList[0]);

class SkinChanger {
public:
    Memory* mem;
    EntityReader* rd;
    uintptr_t client;

    int  selectedSkinIdx = 0;
    bool enabled = false;
    float wear   = 0.01f;
    int  seed    = 420;
    bool statTrak = false;
    int  statTrakKills = 1337;

    SkinChanger(Memory* m, EntityReader* r, uintptr_t c)
        : mem(m), rd(r), client(c) {}

    uintptr_t getActiveWeapon() {
        uintptr_t localPawn = rd->localPawn();
        if (!localPawn || !EntityReader::isPtr(localPawn)) return 0;

        uintptr_t ws = mem->read<uintptr_t>(localPawn + Off::m_pWeaponServices);
        if (!ws || !EntityReader::isPtr(ws)) return 0;

        uint32_t hWeapon = mem->read<uint32_t>(ws + Off::m_hActiveWeapon);
        if (!hWeapon) return 0;

        uintptr_t gsys = mem->read<uintptr_t>(client + Off::dwGameEntitySystem);
        if (!gsys || !EntityReader::isPtr(gsys)) return 0;

        return rd->resolveSlot(gsys, hWeapon & 0x7FFF);
    }

    void apply() {
        if (!enabled) return;

        uintptr_t weapon = getActiveWeapon();
        if (!weapon || !EntityReader::isPtr(weapon)) return;

        int defIdx = mem->read<int>(weapon + 0x1BA8);
        if (defIdx <= 0 || defIdx > 100) return;

        int idHigh = mem->read<int>(weapon + Off::m_iItemIDHigh);
        if (idHigh != -1) {
            mem->write<int>(weapon + Off::m_iItemIDHigh, -1);
        }

        mem->write<int>(weapon + Off::m_nFallbackPaintKit,
                        g_skinList[selectedSkinIdx].paintKit);
        mem->write<float>(weapon + Off::m_flFallbackWear, wear);
        mem->write<int>(weapon + Off::m_nFallbackSeed, seed);

        if (statTrak) {
            mem->write<int>(weapon + Off::m_nFallbackStatTrak, statTrakKills);
        }
    }

    const char* currentSkinName() const {
        if (selectedSkinIdx < 0 || selectedSkinIdx >= g_skinCount) return "None";
        return g_skinList[selectedSkinIdx].name;
    }

    const char* currentWeaponName() const {
        if (selectedSkinIdx < 0 || selectedSkinIdx >= g_skinCount) return "None";
        return g_skinList[selectedSkinIdx].weapon;
    }
};